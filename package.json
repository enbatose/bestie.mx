{
  "name": "bestie-mx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm install --no-audit --no-fund --prefix server && npm run server:build && vite build",
    "preview": "vite preview",
    "start": "npm run server:start",
    "server:dev": "npm run dev --prefix server",
    "server:build": "npm run build --prefix server",
    "server:start": "npm run start --prefix server",
    "env:local": "node scripts/write-env-local.mjs",
    "godaddy:domains": "node --env-file=server/.env scripts/godaddy-api.mjs domains",
    "godaddy:dns": "node --env-file=server/.env scripts/godaddy-api.mjs dns list bestie.mx",
    "godaddy:validate": "node scripts/godaddy-validate.mjs",
    "cloudflare:setup": "node --env-file=server/.env scripts/cloudflare-setup.mjs",
    "dns:cleanup": "node --env-file=server/.env scripts/dns-cutover-cleanup.mjs",
    "dns:cleanup:watch": "node --env-file=server/.env scripts/dns-cutover-cleanup.mjs --watch",
    "dns:cleanup:follow-up": "node --env-file=server/.env scripts/dns-cutover-cleanup.mjs --follow-up --interval 20m",
    "resend:validate": "node scripts/resend-validate.mjs",
    "resend:reforward": "node --env-file=server/.env scripts/resend-reforward-inbound.mjs",
    "railway:set-resend-env": "node --env-file=server/.env scripts/railway-set-resend-env.mjs",
    "google:validate": "node scripts/google-validate.mjs",
    "facebook:validate": "node scripts/facebook-validate.mjs",
    "meta:mcp-auth-check": "node scripts/meta-mcp-auth-preflight.mjs",
    "oauth:golive": "node scripts/oauth-golive.mjs"
  },
  "dependencies": {
    "@posthog/react": "^1.10.3",
    "heic2any": "^0.0.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "posthog-js": "^1.404.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
