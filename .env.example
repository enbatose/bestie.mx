# Frontend (Vite) — copy to `.env.local` for local dev. Do not commit secrets.
# `VITE_*` values are baked into the client bundle at build time.

# Local API origin (empty in production = same-origin `/api`)
VITE_API_URL=http://localhost:3000

# PostHog product analytics (US Cloud). Project token is safe for the browser.
# Production only — leave unset for local / Dev so analytics stay off.
# VITE_POSTHOG_PROJECT_TOKEN=phc_…
# VITE_POSTHOG_HOST=https://us.i.posthog.com
