PORT=3000
# Local: data/bestie.db  |  Railway + volume: /data/bestie.db (mount volume at /data)
DATABASE_PATH=data/bestie.db
# Optional. When unset, uploads go in a sibling `uploads/` folder next to the DB file (same volume as DATABASE_PATH).
# UPLOAD_DIR=/data/uploads
# Comma-separated. Include every frontend origin that calls the API (local + production).
CORS_ORIGINS=http://localhost:5173,https://bestie.mx,https://www.bestie.mx
# Optional. Absolute path, or relative to server cwd. Default ../dist if index.html exists.
# Serves the Vite build from this process so POST /api/* is not blocked by static-only hosting.
# WEB_DIST_DIR=../dist

# Public web origin for email verification and Messenger handoff links (defaults to https://www.bestie.mx).
# PUBLIC_WEB_ORIGIN=https://www.bestie.mx
#
# Public API origin when it differs from PUBLIC_WEB_ORIGIN (usually unnecessary on Railway same-origin deploy).
# PUBLIC_API_ORIGIN=https://www.bestie.mx
#
# --- Email (optional). Without outbound mail, notification emails are skipped (see /api/health → smtp). ---
#
# --- Resend (transactional email) ---
#
# Two-key setup (recommended):
#   RESEND_API_KEY          → app sending (Railway + local). Use "Sending access" on Railway.
#   RESEND_ADMIN_API_KEY    → full_access, LOCAL ONLY — domains, webhooks, MCP admin tools
#   EMAIL_FROM              → e.g. Bestie <no-reply@bestie.mx> (verified domain)
#   RESEND_WEBHOOK_SECRET   → whsec_… from Resend → Webhooks (pairs with POST https://www.bestie.mx/api/resend/webhook)
#                             Create in Resend dashboard or MCP; secret shown once. Set on Railway (API service) too.
#
# Railway (Node/API service): RESEND_API_KEY + EMAIL_FROM only — do NOT put RESEND_ADMIN_API_KEY on Railway.
#
# Cursor Resend MCP reads server/.env via scripts/resend-mcp-launch.mjs (see ~/.cursor/mcp.json).
#
# 1) Resend → Domains → bestie.mx → DNS records → add in GoDaddy (or npm run godaddy:dns)
# 2) API keys: https://resend.com/api-keys
# 3) After deploy: GET /api/health → smtp.mode "resend_api"
#
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_ADMIN_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Bestie <no-reply@bestie.mx>
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx
#
# Option B — Resend via SMTP (same credentials, no SDK — not preferred if RESEND_API_KEY is set)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxx
# EMAIL_FROM=Bestie <notifications@bestie.mx>
#
# Option C — Gmail, minimal (no SMTP_HOST needed). Any one of:
#   GMAIL_USER=you@gmail.com
#   GMAIL_APP_PASSWORD=abcd efgh ijkl mnop   # Google app password; spaces stripped
# Or:
#   SMTP_SERVICE=gmail
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=...
# Or a single connection string (many PaaS templates):
#   SMTP_URL=smtps://you%40gmail.com:YOUR_APP_PASSWORD@smtp.gmail.com:465
#   # (same for EMAIL_URL / MAIL_URL / MAILER_DSN)
#
# 1) Google Account → Security → 2-Step Verification ON
# 2) App passwords: https://support.google.com/accounts/answer/185833 → create "Mail" for this server
# 3) Optional: SMTP_PORT=465 (default) or 587; SMTP_FROM / SMTP_REPLY_TO
#
# After deploy: logs "[email] SMTP verify OK" or "FAILED"; GET /api/health → smtp.mode (gmail_implicit / …), verifyOk
#
# Option D — Any SMTP (SendGrid, Mailgun, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=...
# SMTP_FROM=Bestie <no-reply@bestie.mx>
#
# Gmail via explicit host instead of SMTP_SERVICE (same app password as above):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Bestie <you@gmail.com>
#
# --- GoDaddy API (optional — DNS automation for bestie.mx) ---
# Production: https://api.godaddy.com  |  OTE sandbox: https://api.ote-godaddy.com
# Keys: https://developer.godaddy.com/keys (separate OTE vs Production keys)
# GODADDY_API_KEY=your_production_key
# GODADDY_API_SECRET=your_production_secret
# GODADDY_API_BASE_URL=https://api.godaddy.com
# From repo root:
#   npm run godaddy:domains
#   npm run godaddy:dns
#   node --env-file=server/.env scripts/godaddy-api.mjs dns add bestie.mx --type TXT --name send --data "..."
