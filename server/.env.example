PORT=3000
# Local: data/bestie.db  |  Railway + volume: /data/bestie.db (mount volume at /data)
DATABASE_PATH=data/bestie.db
# Optional. When unset, uploads go in a sibling `uploads/` folder next to the DB file (same volume as DATABASE_PATH).
# UPLOAD_DIR=data/uploads
# Set to 1 to load demo listings when the properties table is empty (local/dev only — leave unset in production).
# SEED_DEMO_ON_EMPTY=1
# UPLOAD_DIR=/data/uploads
# Comma-separated. Include every frontend origin that calls the API (local + production).
CORS_ORIGINS=http://localhost:5173,https://bestie.mx,https://www.bestie.mx,https://dev.bestie.mx
# Optional. Absolute path, or relative to server cwd. Default ../dist if index.html exists.
# Serves the Vite build from this process so POST /api/* is not blocked by static-only hosting.
# WEB_DIST_DIR=../dist

# Public web origin for email verification and Messenger handoff links (defaults to https://www.bestie.mx).
# PUBLIC_WEB_ORIGIN=https://www.bestie.mx
#
# Public API origin when it differs from PUBLIC_WEB_ORIGIN (usually unnecessary on Railway same-origin deploy).
# PUBLIC_API_ORIGIN=https://www.bestie.mx
#
# --- Email (optional). Without outbound mail, notification emails are skipped (see /api/health → smtp). ---
#
# --- Resend (transactional email) ---
#
# Two-key setup (recommended):
#   RESEND_API_KEY          → app sending (Railway + local). Use "Sending access" on Railway.
#   RESEND_ADMIN_API_KEY    → full_access, LOCAL ONLY — domains, webhooks, MCP admin tools
#   RESEND_RECEIVING_API_KEY → full_access key for inbound webhook forward of contacto@bestie.mx
#                              (REQUIRED on Railway; never use sending-only RESEND_API_KEY for this)
#   EMAIL_FROM              → e.g. Bestie <no-reply@bestie.mx> (verified domain)
#   RESEND_WEBHOOK_SECRET   → whsec_… from Resend → Webhooks (POST https://www.bestie.mx/api/resend/webhook)
#                             Subscribed events + full inventory: docs/integrations/resend-webhooks.md
#   RESEND_CONTACT_FORWARD_TO → Gmail (or other inbox) for inbound contacto@bestie.mx (default: batani.enrique@gmail.com)
#   RESEND_CONTACT_FORWARD_FROM → optional From when forwarding (default: Bestie Contacto <contacto@bestie.mx>)
#
# Railway (Node/API service): RESEND_API_KEY + EMAIL_FROM + RESEND_RECEIVING_API_KEY + RESEND_WEBHOOK_SECRET
#   — do NOT put RESEND_ADMIN_API_KEY on Railway.
#   npm run railway:set-resend-env  (pushes receiving key from RECEIVING or ADMIN in server/.env)
#
# --- PostHog (Admin → Métricas live usage) ---
# POSTHOG_PERSONAL_API_KEY=phx_…   # Personal API key with query scope (NOT the project phc_ token)
# POSTHOG_PROJECT_ID=517444        # optional
# POSTHOG_API_HOST=https://us.posthog.com  # optional
#
# Only published inbound address: contacto@bestie.mx (other @bestie.mx mail is received by Resend but not forwarded).
#
# Cursor Resend MCP reads server/.env via scripts/resend-mcp-launch.mjs (see ~/.cursor/mcp.json).
#
# 1) Resend → Domains → bestie.mx → DNS records → add in GoDaddy (or npm run godaddy:dns)
# 2) API keys: https://resend.com/api-keys
# 3) After deploy: GET /api/health → smtp.mode "resend_api"
#
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_ADMIN_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Bestie <no-reply@bestie.mx>
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx
#
# Option B — Resend via SMTP (same credentials, no SDK — not preferred if RESEND_API_KEY is set)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxx
# EMAIL_FROM=Bestie <notifications@bestie.mx>
#
# Option C — Gmail, minimal (no SMTP_HOST needed). Any one of:
#   GMAIL_USER=you@gmail.com
#   GMAIL_APP_PASSWORD=abcd efgh ijkl mnop   # Google app password; spaces stripped
# Or:
#   SMTP_SERVICE=gmail
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=...
# Or a single connection string (many PaaS templates):
#   SMTP_URL=smtps://you%40gmail.com:YOUR_APP_PASSWORD@smtp.gmail.com:465
#   # (same for EMAIL_URL / MAIL_URL / MAILER_DSN)
#
# 1) Google Account → Security → 2-Step Verification ON
# 2) App passwords: https://support.google.com/accounts/answer/185833 → create "Mail" for this server
# 3) Optional: SMTP_PORT=465 (default) or 587; SMTP_FROM / SMTP_REPLY_TO
#
# After deploy: logs "[email] SMTP verify OK" or "FAILED"; GET /api/health → smtp.mode (gmail_implicit / …), verifyOk
#
# Option D — Any SMTP (SendGrid, Mailgun, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=...
# SMTP_FROM=Bestie <no-reply@bestie.mx>
#
# Gmail via explicit host instead of SMTP_SERVICE (same app password as above):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Bestie <you@gmail.com>
#
# --- GoDaddy API (optional — DNS automation for bestie.mx) ---
# Production: https://api.godaddy.com  |  OTE sandbox: https://api.ote-godaddy.com
# Keys: https://developer.godaddy.com/keys (separate OTE vs Production keys)
# GODADDY_API_KEY=your_production_key
# GODADDY_API_SECRET=your_production_secret
# GODADDY_API_BASE_URL=https://api.godaddy.com
# From repo root:
#   npm run godaddy:domains
#   npm run godaddy:dns
#   node --env-file=server/.env scripts/godaddy-api.mjs dns add bestie.mx --type TXT --name send --data "..."
#
# --- Google OAuth (sign-in / sign-up) ---
# Google Cloud → Google Auth Platform → Clients → Web client
# Redirect URIs in console: https://www.bestie.mx/api/auth/google/callback (+ localhost for dev)
# While consent screen is "Testing", add test users under Audience.
# GOOGLE_OAUTH_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
# GOOGLE_OAUTH_REDIRECT_URI=https://www.bestie.mx/api/auth/google/callback
#
# --- Google Cloud (optional — MCP + gcloud CLI) ---
# GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
# Developer Knowledge MCP (Cursor): enable developerknowledge.googleapis.com, create API key, restrict to that API
# GOOGLE_DEVELOPER_KNOWLEDGE_API_KEY=AIza...
# Maps embed/JS key (Vite build + Railway Dockerfile ARG VITE_GOOGLE_MAPS_EMBED_KEY):
# VITE_GOOGLE_MAPS_EMBED_KEY=AIza...
# Validate: npm run google:validate  |  Install gcloud: winget install Google.CloudSDK
#
# --- Gemini (share-copy AI; server-only — never expose to Vite) ---
# GCP project must have generativelanguage.googleapis.com enabled + AI Studio billing/prepay.
# Create/restrict key: https://aistudio.google.com/apikey (or gcloud services api-keys create)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_THINKING_BUDGET=0
# Note: gemini-2.5-flash may be blocked for new projects; prefer 3.1 Flash-Lite / gemini-flash-lite-latest.
# App code must: cache share_ai_text in DB (no re-call on copy/share); disable thinking when the model supports it.
#
# --- Figma (optional — MCP / Code Connect / Design System sync) ---
# Personal Access Token: figma.com -> Settings -> Security -> Personal Access Tokens
# FIGMA_API_KEY=figd_xxxxxxxx
#
# --- Facebook OAuth (sign-in / sign-up) ---
# Meta for Developers → My Apps → Bestie → Settings → Basic (App ID + App Secret)
# Use cases → Facebook Login → Customize → Permissions → add email (fixes "Invalid Scopes: email")
# Facebook Login → Settings → Valid OAuth Redirect URIs:
#   https://www.bestie.mx/api/auth/facebook/callback
#   http://localhost:3000/api/auth/facebook/callback
# FACEBOOK_APP_ID=...
# FACEBOOK_APP_SECRET=...
# FACEBOOK_OAUTH_REDIRECT_URI=https://www.bestie.mx/api/auth/facebook/callback
# FACEBOOK_APP_ID is also injected as fb:app_id in SPA HTML for Sharing Debugger / share attribution.
#
# --- Cloudflare API (optional — DNS + apex→www redirect for bestie.mx) ---
# Account API token: https://dash.cloudflare.com/profile/api-tokens
# Permissions: Zone Read/Edit/Create, DNS Edit, Single Redirect (or Dynamic Redirect) Edit
# CLOUDFLARE_API_TOKEN=your_account_api_token
# CLOUDFLARE_ACCOUNT_ID=your_account_id
# CLOUDFLARE_ZONE_NAME=bestie.mx
# From repo root:
#   node --env-file=server/.env scripts/cloudflare-setup.mjs
# MCP (Cursor ~/.cursor/mcp.json): cloudflare + cloudflare-api — see scripts/cloudflare-mcp-launch.mjs
#
# --- Production backups (Railway bucket + bestie-backup cron; see docs/ops/database-backups.md) ---
# BACKUP_ENABLED=1
# BACKUP_JOB_SECRET=long-random-string
# BACKUP_ALERT_TO=batani.enrique@gmail.com
# BACKUP_TRIGGER_URL=https://www.bestie.mx/api/internal/backup/run
# BACKUP_S3_ENDPOINT=https://...
# BACKUP_S3_BUCKET=bestie-prod-backups
# BACKUP_S3_ACCESS_KEY_ID=...
# BACKUP_S3_SECRET_ACCESS_KEY=...
# BACKUP_S3_REGION=auto
# BACKUP_S3_FORCE_PATH_STYLE=1
# BACKUP_DATA_DIR=/data
# BACKUP_CRON_FORCE=1   # optional one-shot; skip Mexico City midnight guard
